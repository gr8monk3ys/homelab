{
  // Dependency updates for this repo, read by the hosted Renovate app. Every
  // PR it opens runs ci.yml, so the schedule and limits keep the PR count low.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  timezone: "America/Los_Angeles",
  schedule: ["on monday"],
  prConcurrentLimit: 3,
  prHourlyLimit: 2,
  labels: ["dependencies"],
  // Patch and digest updates merge themselves once CI passes (packageRules);
  // everything else is a PR to review.
  automerge: false,

  // Flux sources and releases: HelmRelease + OCIRepository chart tags. The
  // flux manager only reads gotk-components.yaml by default, so name the tree.
  flux: {
    managerFilePatterns: ["/^(clusters|infrastructure|apps)/.+\\.ya?ml$/"],
  },
  // Image tags in plain manifests under the same tree.
  kubernetes: {
    managerFilePatterns: ["/^(clusters|infrastructure|apps)/.+\\.ya?ml$/"],
  },

  customManagers: [
    {
      // Version pins under a comment such as
      //   # renovate: datasource=github-releases depName=yannh/kubeconform extractVersion=^v(?<version>.+)$
      // in ci.yml (KUBECONFORM_VERSION: 0.8.0) and host/setup.sh
      // (K3S_VERSION=v1.37.2+k3s1).
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/ci\\.yml$/", "/^host/setup\\.sh$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?\\s+[A-Z0-9_]+_VERSION(: |=)(?<currentValue>\\S+)",
      ],
    },
  ],

  packageRules: [
    // Majors wait for a tick on the Dependency Dashboard issue.
    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    // K3s: a minor is a Kubernetes minor, so it waits for a tick too, and
    // upgrades go one minor at a time.
    {
      matchPackageNames: ["k3s-io/k3s"],
      versioning: "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$",
      prBodyNotes: ["Apply with `sudo ./host/setup.sh` after merging. K3s also moves the bundled Traefik and Gateway API CRDs; check `infrastructure/controllers/traefik.yaml` still applies."],
    },
    {
      matchPackageNames: ["k3s-io/k3s"],
      matchUpdateTypes: ["minor"],
      dependencyDashboardApproval: true,
    },
    // home-operations publishes the arr apps' prerelease branches under the
    // same image name: stay on the stable majors until upstream releases.
    { matchPackageNames: ["ghcr.io/home-operations/sonarr"], allowedVersions: "<5" },
    { matchPackageNames: ["ghcr.io/home-operations/radarr"], allowedVersions: "<7" },
    { matchPackageNames: ["ghcr.io/home-operations/prowlarr"], allowedVersions: "<3" },
    // Patch and digest bumps merge themselves after CI (not K3s, not databases).
    {
      matchUpdateTypes: ["patch", "digest"],
      matchPackageNames: ["!k3s-io/k3s", "!ghcr.io/tensorchord/cloudnative-vectorchord"],
      automerge: true,
    },
    // Database majors need a dump and restore: never proposed.
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["postgres", "mariadb", "redis", "valkey/valkey"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    // Immich's Postgres image tracks the Immich release notes, not a version line.
    {
      matchPackageNames: ["ghcr.io/immich-app/postgres", "ghcr.io/tensorchord/cloudnative-vectorchord"],
      enabled: false,
    },
    // Minor and patch image bumps across the apps: one weekly PR.
    {
      matchDatasources: ["docker"],
      matchFileNames: ["apps/**"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      groupName: "app images (minor and patch)",
    },
    // The groups below come after the catch-all: a later packageRule wins.
    // Immich server and machine-learning must run the same version.
    {
      matchPackageNames: ["ghcr.io/immich-app/immich-server", "ghcr.io/immich-app/immich-machine-learning"],
      groupName: "immich",
    },
    // The CI tool pins in ci.yml carry a sha256 that must move with the version.
    {
      matchFileNames: [".github/workflows/ci.yml"],
      prBodyNotes: ["If this bumps KUSTOMIZE_VERSION, KUBECONFORM_VERSION or YQ_VERSION, update the matching *_SHA256 from the release's checksums file."],
    },
  ],
}
