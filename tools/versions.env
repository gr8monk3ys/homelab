# Pinned tool versions for reproducible local runs and CI.
#
# Shell scripts in this repo should prefer sourcing this file over embedding versions.
#
# Notes:
# - Versions with a leading "v" match upstream release tags (e.g., Helm, Kustomize).
# - Some tools use plain numeric versions (e.g., kubeconform, yamllint pip package).

# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v4.3.1
# renovate: datasource=github-releases depName=kubernetes-sigs/kustomize extractVersion=^kustomize/(?<version>v.+)$
KUSTOMIZE_VERSION=v5.3.0
# renovate: datasource=github-releases depName=yannh/kubeconform extractVersion=^v(?<version>.+)$
KUBECONFORM_VERSION=0.6.4

# renovate: datasource=github-releases depName=mikefarah/yq
YQ_VERSION=v4.44.3
# renovate: datasource=github-releases depName=FiloSottile/age
AGE_VERSION=v1.1.1
# renovate: datasource=github-releases depName=getsops/sops
SOPS_VERSION=v3.10.2

# renovate: datasource=github-releases depName=kubernetes-sigs/kind
KIND_VERSION=v0.30.0
# Pin the Kubernetes version used by Kind clusters (test/setup-kind.sh).
# Keep this within +/-1 minor of KUBECTL_VERSION to avoid kubectl skew issues.
# Digest is kind v0.30.0's default node image (see the kind release notes).
KIND_NODE_IMAGE=kindest/node:v1.34.0@sha256:7416a61b42b1662ca6ca89f02028ac133a309a2a30ba309614e8ec94d976dc5a
KUBECTL_VERSION=v1.34.0

# renovate: datasource=pypi depName=yamllint
YAMLLINT_VERSION=1.35.1
# renovate: datasource=pypi depName=shellcheck-py
SHELLCHECK_PY_VERSION=0.10.0.1
# renovate: datasource=pypi depName=pre-commit
PRE_COMMIT_VERSION=4.3.0

# Helm chart versions
# renovate: datasource=helm depName=kyverno registryUrl=https://kyverno.github.io/kyverno/
KYVERNO_CHART_VERSION=3.7.0
# renovate: datasource=helm depName=velero registryUrl=https://vmware-tanzu.github.io/helm-charts
VELERO_CHART_VERSION=11.3.2
# renovate: datasource=helm depName=traefik registryUrl=https://traefik.github.io/charts
TRAEFIK_CHART_VERSION=39.0.1
# renovate: datasource=helm depName=external-secrets registryUrl=https://charts.external-secrets.io
EXTERNAL_SECRETS_CHART_VERSION=2.0.0
# renovate: datasource=helm depName=cert-manager registryUrl=https://charts.jetstack.io
CERT_MANAGER_CHART_VERSION=v1.20.3
# renovate: datasource=helm depName=kube-prometheus-stack registryUrl=https://prometheus-community.github.io/helm-charts
KUBE_PROMETHEUS_STACK_CHART_VERSION=82.0.0
# renovate: datasource=helm depName=metallb registryUrl=https://metallb.github.io/metallb
METALLB_CHART_VERSION=0.15.3
# renovate: datasource=helm depName=external-dns registryUrl=https://kubernetes-sigs.github.io/external-dns/
EXTERNAL_DNS_CHART_VERSION=1.20.0
# renovate: datasource=helm depName=prometheus-blackbox-exporter registryUrl=https://prometheus-community.github.io/helm-charts
PROMETHEUS_BLACKBOX_EXPORTER_CHART_VERSION=11.8.0

# Opt-in service charts (kubernetes/services/<name>/service.yaml, kind: helm).
# renovate: datasource=helm depName=longhorn registryUrl=https://charts.longhorn.io
LONGHORN_CHART_VERSION=1.10.2
# renovate: datasource=helm depName=volsync registryUrl=https://backube.github.io/helm-charts/
VOLSYNC_CHART_VERSION=0.17.0
# The published node-feature-discovery and tailscale-operator charts are
# versioned to match their release; the in-repo Chart.yaml carries a
# placeholder, so bump these to the release you want.
# renovate: datasource=helm depName=node-feature-discovery registryUrl=https://kubernetes-sigs.github.io/node-feature-discovery/charts
NFD_CHART_VERSION=0.18.0
# renovate: datasource=helm depName=tailscale-operator registryUrl=https://pkgs.tailscale.com/helmcharts
TAILSCALE_OPERATOR_CHART_VERSION=1.90.0
# renovate: datasource=helm depName=nvidia-device-plugin registryUrl=https://nvidia.github.io/k8s-device-plugin
NVIDIA_DEVICE_PLUGIN_CHART_VERSION=0.20.0

# Pinned component versions (non-Helm install sources)
# renovate: datasource=github-releases depName=argoproj/argo-cd
ARGOCD_VERSION=v3.6.1

# CLI tool versions (non-Kubernetes, installed into .tools/bin)
# renovate: datasource=github-releases depName=vmware-tanzu/velero
VELERO_CLI_VERSION=v1.17.1

# test/e2e-default-install.sh: a real etcd + kube-apiserver (no kubelet) from
# the controller-tools envtest release, and the Prometheus Operator CRDs that
# KUBE_PROMETHEUS_STACK_CHART_VERSION would install (its appVersion).
ENVTEST_VERSION=v1.34.1
PROMETHEUS_OPERATOR_VERSION=v0.89.0
