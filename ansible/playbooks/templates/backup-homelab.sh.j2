#!/usr/bin/env bash
set -euo pipefail

# {{ ansible_managed | default('Managed by Ansible - do not edit manually.') }}
# Creates a compressed tar archive of the configured homelab paths and prunes
# archives older than the retention window. Settings mirror {{ backup_dir }}/config.yaml.

BACKUP_DIR="{{ backup_dir }}"
RETENTION_DAYS="{{ backup_retention_days | default(14) }}"
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
ARCHIVE="${BACKUP_DIR}/homelab-${TIMESTAMP}.tar.gz"

SOURCES=(
{% for src in backup_sources | default(['/etc/rancher', '/opt/homelab/config']) %}
    "{{ src }}"
{% endfor %}
)

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

mkdir -p "$BACKUP_DIR"

existing_sources=()
existing_count=0
for src in "${SOURCES[@]}"; do
    if [ -e "$src" ]; then
        existing_sources+=("$src")
        existing_count=$((existing_count+1))
    else
        log "WARNING: backup source not found, skipping: $src"
    fi
done

if [ "$existing_count" -eq 0 ]; then
    log "ERROR: none of the configured backup sources exist; nothing to back up"
    exit 1
fi

log "Creating backup archive: $ARCHIVE"
tar -czf "$ARCHIVE" "${existing_sources[@]}"
chmod 600 "$ARCHIVE"

log "Pruning archives older than ${RETENTION_DAYS} days..."
find "$BACKUP_DIR" -maxdepth 1 -type f -name 'homelab-*.tar.gz' -mtime "+${RETENTION_DAYS}" -delete

log "Backup completed: $ARCHIVE"
