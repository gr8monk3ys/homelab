# Pinned tool versions for reproducible local runs and CI.
#
# Shell scripts in this repo should prefer sourcing this file over embedding versions.
#
# Notes:
# - Versions with a leading "v" match upstream release tags (e.g., Helm, Kustomize).
# - Some tools use plain numeric versions (e.g., kubeconform, yamllint pip package).

HELM_VERSION=v3.21.2
KUSTOMIZE_VERSION=v5.3.0
KUBECONFORM_VERSION=0.6.4

YQ_VERSION=v4.44.3
AGE_VERSION=v1.1.1
SOPS_VERSION=v3.10.2

KIND_VERSION=v0.30.0
# Pin the Kubernetes version used by Kind clusters (test/setup-kind.sh).
# Keep this within +/-1 minor of KUBECTL_VERSION to avoid kubectl skew issues.
# Digest is kind v0.30.0's default node image (see the kind release notes).
KIND_NODE_IMAGE=kindest/node:v1.34.0@sha256:7416a61b42b1662ca6ca89f02028ac133a309a2a30ba309614e8ec94d976dc5a
KUBECTL_VERSION=v1.34.0

YAMLLINT_VERSION=1.35.1
SHELLCHECK_PY_VERSION=0.10.0.1
PRE_COMMIT_VERSION=4.3.0

# Helm chart versions
KYVERNO_CHART_VERSION=3.7.0
VELERO_CHART_VERSION=11.3.2
TRAEFIK_CHART_VERSION=39.0.1
EXTERNAL_SECRETS_CHART_VERSION=2.0.0
CERT_MANAGER_CHART_VERSION=v1.20.3
KUBE_PROMETHEUS_STACK_CHART_VERSION=82.0.0
METALLB_CHART_VERSION=0.15.3
EXTERNAL_DNS_CHART_VERSION=1.20.0
PROMETHEUS_BLACKBOX_EXPORTER_CHART_VERSION=11.8.0

# Opt-in service charts (kubernetes/services/<name>/service.yaml, kind: helm).
LONGHORN_CHART_VERSION=1.10.2
VOLSYNC_CHART_VERSION=0.17.0
# The published node-feature-discovery and tailscale-operator charts are
# versioned to match their release; the in-repo Chart.yaml carries a
# placeholder, so bump these to the release you want.
NFD_CHART_VERSION=0.18.0
TAILSCALE_OPERATOR_CHART_VERSION=1.90.0
NVIDIA_DEVICE_PLUGIN_CHART_VERSION=0.20.0

# Pinned component versions (non-Helm install sources)
ARGOCD_VERSION=v2.10.0

# CLI tool versions (non-Kubernetes, installed into .tools/bin)
VELERO_CLI_VERSION=v1.17.1

# test/e2e-default-install.sh: a real etcd + kube-apiserver (no kubelet) from
# the controller-tools envtest release, and the Prometheus Operator CRDs that
# KUBE_PROMETHEUS_STACK_CHART_VERSION would install (its appVersion).
ENVTEST_VERSION=v1.34.1
PROMETHEUS_OPERATOR_VERSION=v0.89.0
