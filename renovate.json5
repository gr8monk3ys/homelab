{
  // Dependency updates for this repo, read by the hosted Renovate app. Every
  // PR it opens runs ci.yml, so the schedule and limits keep the PR count low.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  timezone: "America/Los_Angeles",
  schedule: ["on monday"],
  prConcurrentLimit: 3,
  prHourlyLimit: 2,
  labels: ["dependencies"],
  // Nothing merges by itself; every update is a PR to review.
  automerge: false,

  // Flux sources and releases: HelmRelease + OCIRepository chart tags. The
  // flux manager only reads gotk-components.yaml by default, so name the tree.
  flux: {
    managerFilePatterns: ["/^(clusters|infrastructure|apps)/.+\\.ya?ml$/"],
  },
  // Image tags in plain manifests under the same tree.
  kubernetes: {
    managerFilePatterns: ["/^(clusters|infrastructure|apps)/.+\\.ya?ml$/"],
  },

  customManagers: [
    {
      // The K3s image in the k3d cluster config. K3s also pins the bundled
      // Traefik chart and Gateway API CRDs, so this PR updates those too.
      customType: "regex",
      managerFilePatterns: ["/^k3d/homelab\\.yaml$/"],
      matchStrings: ["image: (?<depName>rancher/k3s):(?<currentValue>v[0-9.]+-k3s[0-9]+)"],
      datasourceTemplate: "docker",
      versioningTemplate: "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-k3s(?<build>\\d+)$",
    },
    {
      // Tool pins in ci.yml, each under a comment such as
      //   # renovate: datasource=github-releases depName=yannh/kubeconform extractVersion=^v(?<version>.+)$
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/ci\\.yml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?\\s+[A-Z_]+_VERSION: (?<currentValue>\\S+)",
      ],
    },
  ],

  packageRules: [
    // Majors wait for a tick on the Dependency Dashboard issue.
    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    // A K3s minor is a Kubernetes minor: wait for a tick too.
    {
      matchPackageNames: ["rancher/k3s"],
      matchUpdateTypes: ["minor"],
      dependencyDashboardApproval: true,
      prBodyNotes: ["Recreate the k3d cluster to apply (README, \"Local cluster\"). K3s also moves the bundled Traefik and Gateway API CRDs; check the Traefik values in `infrastructure/controllers/traefik.yaml` still apply."],
    },
    // Database majors need a dump and restore: never proposed.
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["postgres", "mariadb", "redis", "valkey/valkey"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    // Immich's Postgres image tracks the Immich release notes, not a version line.
    {
      matchPackageNames: ["ghcr.io/immich-app/postgres", "ghcr.io/tensorchord/cloudnative-vectorchord"],
      enabled: false,
    },
    // Minor and patch image bumps across the apps: one weekly PR.
    {
      matchDatasources: ["docker"],
      matchFileNames: ["apps/**"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      groupName: "app images (minor and patch)",
    },
    // The groups below come after the catch-all: a later packageRule wins.
    // Immich server and machine-learning must run the same version.
    {
      matchPackageNames: ["ghcr.io/immich-app/immich-server", "ghcr.io/immich-app/immich-machine-learning"],
      groupName: "immich",
    },
    // The CI tool pins in ci.yml carry a sha256 that must move with the version.
    {
      matchFileNames: [".github/workflows/ci.yml"],
      prBodyNotes: ["If this bumps KUSTOMIZE_VERSION or KUBECONFORM_VERSION, update the matching *_SHA256 from the release's checksums file."],
    },
  ],
}
